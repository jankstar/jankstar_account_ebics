<tryton>
    <data>
        <!-- Run log of the downloads (request of the user, 27.11.2026) -->
        <record model="ir.ui.view" id="run_view_form">
            <field name="model">account.ebics.run</field>
            <field name="type">form</field>
            <field name="name">log/run_form</field>
        </record>
        <record model="ir.ui.view" id="run_view_list">
            <field name="model">account.ebics.run</field>
            <field name="type">tree</field>
            <field name="name">log/run_list</field>
        </record>

        <record model="ir.action.act_window" id="act_run_form">
            <field name="name">Runs</field>
            <field name="res_model">account.ebics.run</field>
        </record>
        <record model="ir.action.act_window.view" id="act_run_form_view1">
            <field name="sequence" eval="10"/>
            <field name="view" ref="run_view_list"/>
            <field name="act_window" ref="act_run_form"/>
        </record>
        <record model="ir.action.act_window.view" id="act_run_form_view2">
            <field name="sequence" eval="20"/>
            <field name="view" ref="run_view_form"/>
            <field name="act_window" ref="act_run_form"/>
        </record>
        <menuitem
            parent="menu_ebics"
            action="act_run_form"
            sequence="70"
            id="menu_run_form"/>

        <!-- Read only for both groups; created and changed only by the
             server code -->
        <record model="ir.model.access" id="access_run">
            <field name="model">account.ebics.run</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_run_ebics">
            <field name="model">account.ebics.run</field>
            <field name="group" ref="group_ebics"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_run_ebics_admin">
            <field name="model">account.ebics.run</field>
            <field name="group" ref="group_ebics_admin"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>

        <!-- runs of the companies of the user; a run without company
             (cron without company) is visible to all EBICS users -->
        <record model="ir.rule.group" id="rule_group_run_companies">
            <field name="name">User in companies</field>
            <field name="model">account.ebics.run</field>
            <field name="global_p" eval="True"/>
        </record>
        <record model="ir.rule" id="rule_run_companies">
            <field name="domain"
                eval="['OR', ('company', 'in', Eval('companies', [])), ('company', '=', None)]"
                pyson="1"/>
            <field name="rule_group" ref="rule_group_run_companies"/>
        </record>
    </data>
</tryton>
