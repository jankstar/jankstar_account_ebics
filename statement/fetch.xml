<tryton>
    <data>
        <!-- Result page of the downloads (variant C, 27.11.2026) -->
        <record model="ir.ui.view" id="fetch_result_view_form">
            <field name="model">account.ebics.fetch.result</field>
            <field name="type">form</field>
            <field name="name">statement/fetch_result_form</field>
        </record>
        <record model="ir.ui.view" id="fetch_result_line_view_list">
            <field name="model">account.ebics.fetch.result.line</field>
            <field name="type">tree</field>
            <field name="name">statement/fetch_result_line_list</field>
        </record>
        <record model="ir.ui.view" id="fetch_statements_start_view_form">
            <field name="model">account.ebics.fetch_statements.start</field>
            <field name="type">form</field>
            <field name="name">statement/fetch_statements_start_form</field>
        </record>

        <!-- Financial > EBICS > Fetch Statements (working paper E08 F1) -->
        <record model="ir.action.wizard" id="wizard_fetch_statements">
            <field name="name">Fetch Statements</field>
            <field name="wiz_name">account.ebics.fetch_statements</field>
        </record>
        <record model="ir.action-res.group" id="wizard_fetch_statements_group_ebics">
            <field name="action" ref="wizard_fetch_statements"/>
            <field name="group" ref="group_ebics"/>
        </record>
        <record model="ir.action-res.group" id="wizard_fetch_statements_group_ebics_admin">
            <field name="action" ref="wizard_fetch_statements"/>
            <field name="group" ref="group_ebics_admin"/>
        </record>
        <menuitem
            parent="menu_ebics"
            action="wizard_fetch_statements"
            sequence="10"
            id="menu_fetch_statements"/>

        <!-- Financial > EBICS > Fetch Statements for Period Again (F10) -->
        <record model="ir.ui.view" id="fetch_period_start_view_form">
            <field name="model">account.ebics.fetch_period.start</field>
            <field name="type">form</field>
            <field name="name">statement/fetch_period_start_form</field>
        </record>
        <record model="ir.action.wizard" id="wizard_fetch_period">
            <field name="name">Fetch Statements for Period Again</field>
            <field name="wiz_name">account.ebics.fetch_period</field>
        </record>
        <record model="ir.action-res.group" id="wizard_fetch_period_group_ebics">
            <field name="action" ref="wizard_fetch_period"/>
            <field name="group" ref="group_ebics"/>
        </record>
        <record model="ir.action-res.group" id="wizard_fetch_period_group_ebics_admin">
            <field name="action" ref="wizard_fetch_period"/>
            <field name="group" ref="group_ebics_admin"/>
        </record>
        <record model="ir.action.keyword" id="wizard_fetch_period_keyword">
            <field name="keyword">form_action</field>
            <field name="model">account.ebics.configuration,-1</field>
            <field name="action" ref="wizard_fetch_period"/>
        </record>
        <menuitem
            parent="menu_ebics"
            action="wizard_fetch_period"
            sequence="20"
            id="menu_fetch_period"/>
    </data>
</tryton>
