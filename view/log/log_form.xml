<form>
    <label name="configuration"/>
    <field name="configuration"/>
    <label name="company"/>
    <field name="company"/>
    <label name="timestamp"/>
    <field name="timestamp"/>
    <label name="state"/>
    <field name="state"/>
    <label name="order_type"/>
    <field name="order_type"/>
    <label name="format"/>
    <field name="format"/>
    <label name="btf_params"/>
    <field name="btf_params"/>
    <label name="receipt"/>
    <field name="receipt"/>
    <label name="date_from"/>
    <field name="date_from"/>
    <label name="date_to"/>
    <field name="date_to"/>
    <notebook colspan="4">
        <page string="Return" id="return">
            <label name="transaction_id"/>
            <field name="transaction_id"/>
            <label name="ebics_order_id"/>
            <field name="ebics_order_id"/>
            <label name="technical_return_code"/>
            <field name="technical_return_code"/>
            <label name="business_return_code"/>
            <field name="business_return_code"/>
            <label name="return_message"/>
            <field name="return_message" colspan="3"/>
            <label name="payload"/>
            <field name="payload" colspan="3"/>
            <field name="payload_filename" invisible="1" colspan="4"/>
        </page>
        <page name="files">
            <field name="files" colspan="4"/>
        </page>
    </notebook>
</form>
