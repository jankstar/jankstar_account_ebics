<!-- This file is part of the account_ebics module for Tryton.
The COPYRIGHT file at the top level of this repository contains the full
copyright notices and license terms. -->
<form>
    <label name="name"/>
    <field name="name"/>
    <label name="state"/>
    <field name="state"/>
    <notebook colspan="4">
        <page string="Access" id="access">
            <label name="company"/>
            <field name="company"/>
            <label name="bank"/>
            <field name="bank"/>
            <label name="url"/>
            <field name="url" colspan="3"/>
            <label name="host_id"/>
            <field name="host_id"/>
            <label name="ebics_version"/>
            <field name="ebics_version"/>
            <label name="partner_id"/>
            <field name="partner_id"/>
            <label name="key_bitlength"/>
            <field name="key_bitlength"/>
            <label name="user_id"/>
            <field name="user_id"/>
            <label name="signature_class"/>
            <field name="signature_class"/>
            <label name="last_fetch"/>
            <field name="last_fetch"/>
        </page>
        <page name="accounts">
            <field name="accounts" colspan="4"/>
        </page>
        <page name="formats">
            <field name="formats" colspan="4"/>
        </page>
        <page string="Keys" id="keys">
            <label name="ini_sent"/>
            <field name="ini_sent"/>
            <label name="hia_sent"/>
            <field name="hia_sent"/>
            <separator string="User Certificates" colspan="4" id="user_keys"/>
            <label name="user_a006_hash"/>
            <field name="user_a006_hash" colspan="3"/>
            <label name="user_x002_hash"/>
            <field name="user_x002_hash" colspan="3"/>
            <label name="user_e002_hash"/>
            <field name="user_e002_hash" colspan="3"/>
            <separator string="Bank Certificates" colspan="4" id="bank_keys"/>
            <label name="bank_x002_hash_expected"/>
            <field name="bank_x002_hash_expected" colspan="3"/>
            <label name="bank_e002_hash_expected"/>
            <field name="bank_e002_hash_expected" colspan="3"/>
            <group col="4" colspan="4" id="bank_hashes">
                <separator name="bank_x002_hash_groups" colspan="2"/>
                <separator name="bank_x002_hash_expected_groups" colspan="2"/>
                <field name="bank_x002_hash_groups" colspan="2" height="60" widget="text"/>
                <field name="bank_x002_hash_expected_groups" colspan="2" height="60" widget="text"/>
                <label name="bank_x002_hash_check"/>
                <field name="bank_x002_hash_check" colspan="3"/>
                <separator name="bank_e002_hash_groups" colspan="2"/>
                <separator name="bank_e002_hash_expected_groups" colspan="2"/>
                <field name="bank_e002_hash_groups" colspan="2" height="60" widget="text"/>
                <field name="bank_e002_hash_expected_groups" colspan="2" height="60" widget="text"/>
                <label name="bank_e002_hash_check"/>
                <field name="bank_e002_hash_check" colspan="3"/>
            </group>
        </page>
        <page name="logs">
            <field name="logs" colspan="4"/>
        </page>
    </notebook>
    <group col="-1" colspan="4" id="buttons">
        <button name="reset_draft" icon="tryton-clear"/>
        <button name="print_ini_letter" icon="tryton-print"/>
        <button name="print_hia_letter" icon="tryton-print"/>
        <button name="generate_keys" icon="tryton-launch"/>
        <button name="send_ini" icon="tryton-forward"/>
        <button name="send_hia" icon="tryton-forward"/>
        <button name="suspend" icon="tryton-cancel"/>
        <button name="reactivate" icon="tryton-refresh"/>
        <button name="fetch_bank_keys" icon="tryton-download"/>
        <button name="confirm_bank_keys" icon="tryton-ok"/>
        <button name="download_statements" icon="tryton-download"/>
    </group>
</form>
