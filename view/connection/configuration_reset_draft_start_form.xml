<form col="2">
    <image name="tryton-warning" xexpand="0" xfill="0"/>
    <group col="1" id="explanation" xexpand="1">
        <label string="The private keys of this connection will be deleted for good. There is no backup." id="explanation_keys" xalign="0.0"/>
        <label string="The bank still knows the old keys. It must reset the participant or create it again before new keys can be sent." id="explanation_bank" xalign="0.0"/>
        <label string="Afterwards generate the keys, send INI and HIA and print new initialisation letters." id="explanation_next" xalign="0.0"/>
        <label string="The log is kept." id="explanation_log" xalign="0.0"/>
    </group>
    <group col="4" colspan="2" id="connection">
        <label name="name"/>
        <field name="name"/>
        <label name="host_id"/>
        <field name="host_id"/>
        <label name="partner_id"/>
        <field name="partner_id"/>
        <label name="user_id"/>
        <field name="user_id"/>
    </group>
    <field name="confirm" colspan="2"/>
</form>
