msgctxt "help:account.ebics.account,bank_account:"
msgid "Active bank account of the company with an IBAN."
msgstr "Aktives Bankkonto des Unternehmens mit IBAN."

msgctxt "help:account.ebics.account,company:"
msgid "The company of the connection."
msgstr "Das Unternehmen des Zugangs."

msgctxt "help:account.ebics.account,import_statements:"
msgid "Import the camt.053 statements of this account."
msgstr "Die camt.053-Auszüge dieses Kontos importieren."

msgctxt "help:account.ebics.account,statement_journal:"
msgid ""
"The statement journal that account_statement_sepa finds for the IBAN and currency of the bank account.\n"
"If empty, no or more than one journal matches; statements cannot be imported."
msgstr ""
"Das Kontoauszugsjournal, das account_statement_sepa über IBAN und Währung des Bankkontos findet.\n"
"Ist das Feld leer, passt kein oder mehr als ein Journal; Auszüge können dann nicht importiert werden."

msgctxt "help:account.ebics.configuration,bank_e002_hash_expected:"
msgid ""
"Hash value of the bank's E002 certificate as published by the bank (64 "
"hexadecimal characters, spaces are ignored)."
msgstr ""
"Von der Bank veröffentlichter Hashwert des E002-Zertifikats der Bank (64 "
"Hexadezimalzeichen, Leerzeichen werden ignoriert)."

msgctxt "help:account.ebics.configuration,bank_x002_hash_expected:"
msgid ""
"Hash value of the bank's X002 certificate as published by the bank (64 "
"hexadecimal characters, spaces are ignored)."
msgstr ""
"Von der Bank veröffentlichter Hashwert des X002-Zertifikats der Bank (64 "
"Hexadezimalzeichen, Leerzeichen werden ignoriert)."

msgctxt "help:account.ebics.configuration,company:"
msgid "The company that holds the EBICS contract."
msgstr "Das Unternehmen, das den EBICS-Vertrag hält."

msgctxt "help:account.ebics.configuration,formats:"
msgid "The formats to download for all accounts of this connection."
msgstr "Die Formate, die für alle Konten dieses Zugangs abgerufen werden."

msgctxt "help:account.ebics.configuration,key_bitlength:"
msgid "Length of the RSA keys in bits, as required by the bank."
msgstr "Länge der RSA-Schlüssel in Bit nach Vorgabe der Bank."

msgctxt "help:account.ebics.configuration,signature_class:"
msgid "Only effective with payment upload (v2)."
msgstr "Erst mit dem Zahlungs-Upload (v2) wirksam."

msgctxt "help:account.ebics.configuration,url:"
msgid "EBICS URL of the bank (https:// only)."
msgstr "EBICS-URL der Bank (nur https://)."

msgctxt "help:account.ebics.format,active:"
msgid "Deactivate standard formats instead of deleting them."
msgstr "Standardformate deaktivieren statt löschen."

msgctxt "help:account.ebics.format,msg_name:"
msgid "BTF message name, e.g. camt.053."
msgstr "BTF-Nachrichtenname, z. B. camt.053."

msgctxt "help:account.ebics.format,msg_version:"
msgid "Optional BTF message version, e.g. 08."
msgstr "Optionale BTF-Nachrichtenversion, z. B. 08."

msgctxt "help:account.ebics.format,processing:"
msgid "What happens with the downloaded files."
msgstr "Was mit den abgerufenen Dateien geschieht."

msgctxt "help:account.ebics.format,scope:"
msgid "BTF scope, e.g. DE. Leave empty for global formats."
msgstr "BTF-Geltungsbereich, z. B. DE. Leer bei globalen Formaten."

msgctxt "help:account.ebics.format,service_name:"
msgid "BTF service name, e.g. EOP, STM, SCT."
