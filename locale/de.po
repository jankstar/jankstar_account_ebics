msgctxt "model:ir.message,text:msg_account_bank_account_unique"
msgid "A bank account can be released only once per EBICS connection."
msgstr "Ein Bankkonto kann je EBICS-Zugang nur einmal freigegeben werden."

#, python-format
msgctxt "model:ir.message,text:msg_account_company"
msgid ""
"The company of account \"%(account)s\" must be the company of EBICS "
"connection \"%(configuration)s\"."
msgstr ""
"Das Unternehmen des Kontos „%(account)s“ muss das Unternehmen des EBICS-"
"Zugangs „%(configuration)s“ sein."

#, python-format
msgctxt "model:ir.message,text:msg_account_iban_required"
msgid "The bank account \"%(bank_account)s\" has no IBAN."
msgstr "Das Bankkonto „%(bank_account)s“ hat keine IBAN."

#, python-format
msgctxt "model:ir.message,text:msg_account_validity"
msgid ""
"The start of validity of account \"%(account)s\" must not be after its end."
msgstr ""
"Der Beginn der Gültigkeit des Kontos „%(account)s“ darf nicht nach ihrem "
"Ende liegen."

#, python-format
msgctxt "model:ir.message,text:msg_bank_keys_changed"
msgid ""
"The bank keys of EBICS connection \"%(configuration)s\" have changed. "
"Compare the new hash values with the information of the bank and confirm "
"them; until then no orders are possible."
msgstr ""
"Die Bankschlüssel des EBICS-Zugangs „%(configuration)s“ haben sich geändert."
" Die neuen Hashwerte mit den Angaben der Bank vergleichen und bestätigen; "
"bis dahin sind keine Aufträge möglich."

#, python-format
msgctxt "model:ir.message,text:msg_bank_keys_changed_meanwhile"
msgid ""
"The bank keys of EBICS connection \"%(configuration)s\" have changed in the "
"meantime. Please open the dialog again."
msgstr ""
"Die Bankschlüssel des EBICS-Zugangs „%(configuration)s“ haben sich "
"inzwischen geändert. Bitte den Dialog erneut öffnen."

#, python-format
msgctxt "model:ir.message,text:msg_bank_keys_mismatch"
msgid ""
"The hash values of the bank keys of EBICS connection \"%(configuration)s\" "
"differ from the expected values. Check the information of the bank and fetch"
" the bank keys again."
msgstr ""
"Die Hashwerte der Bankschlüssel des EBICS-Zugangs „%(configuration)s“ "
"weichen von den erwarteten Werten ab. Die Angaben der Bank prüfen und die "
"Bankschlüssel erneut abrufen."

#, python-format
msgctxt "model:ir.message,text:msg_bank_keys_missing"
msgid "EBICS connection \"%(configuration)s\" has no confirmed bank keys."
msgstr ""
"Der EBICS-Zugang „%(configuration)s“ hat keine bestätigten Bankschlüssel."

#, python-format
msgctxt "model:ir.message,text:msg_bank_keys_not_compared"
msgid ""
"Please confirm that you compared the hash values of the bank keys of EBICS "
"connection \"%(configuration)s\" with the information of the bank."
msgstr ""
"Bitte bestätigen, dass die Hashwerte der Bankschlüssel des EBICS-Zugangs "
"„%(configuration)s“ mit den Angaben der Bank verglichen wurden."

#, python-format
msgctxt "model:ir.message,text:msg_bank_keys_received"
msgid ""
"The bank keys of EBICS connection \"%(configuration)s\" were received. "
"Compare the hash values with the information of the bank and confirm them."
msgstr ""
"Die Bankschlüssel des EBICS-Zugangs „%(configuration)s“ wurden abgerufen. "
"Die Hashwerte mit den Angaben der Bank vergleichen und bestätigen."

#, python-format
msgctxt "model:ir.message,text:msg_bank_keys_unchanged"
msgid "The bank keys of EBICS connection \"%(configuration)s\" are unchanged."
msgstr ""
"Die Bankschlüssel des EBICS-Zugangs „%(configuration)s“ sind unverändert."

#, python-format
msgctxt "model:ir.message,text:msg_bank_keys_update_required"
msgid ""
"The bank has new keys for EBICS connection \"%(configuration)s\" "
"(%(order_type)s: 091008 EBICS_BANK_PUBKEY_UPDATE_REQUIRED). Fetch the bank "
"keys (HPB) and confirm them."
msgstr ""
"Die Bank hat neue Schlüssel für den EBICS-Zugang „%(configuration)s“ "
"(%(order_type)s: 091008 EBICS_BANK_PUBKEY_UPDATE_REQUIRED). Die "
"Bankschlüssel abrufen (HPB) und bestätigen."

#, python-format
msgctxt "model:ir.message,text:msg_bank_keys_wrong_state"
msgid ""
"The bank keys of EBICS connection \"%(configuration)s\" can only be "
"confirmed in the state \"Bank Keys Received\"."
msgstr ""
"Die Bankschlüssel des EBICS-Zugangs „%(configuration)s“ können nur im Status"
" „Bankschlüssel empfangen“ bestätigt werden."

msgctxt "model:ir.message,text:msg_configuration_format_unique"
msgid "A format can be added only once to an EBICS connection."
msgstr "Ein Format kann einem EBICS-Zugang nur einmal zugeordnet werden."

#, python-format
msgctxt "model:ir.message,text:msg_configuration_hash_format"
msgid ""
"The value of \"%(field)s\" of EBICS connection \"%(configuration)s\" must "
"consist of 64 hexadecimal characters."
msgstr ""
"Der Wert von „%(field)s“ des EBICS-Zugangs „%(configuration)s“ muss aus 64 "
"Hexadezimalzeichen bestehen."

#, python-format
msgctxt "model:ir.message,text:msg_configuration_ids"
msgid ""
"The values \"%(fields)s\" of EBICS connection \"%(configuration)s\" are not "
"valid EBICS identifiers."
msgstr ""
"Die Werte „%(fields)s“ des EBICS-Zugangs „%(configuration)s“ sind keine "
"gültigen EBICS-Kennungen."

msgctxt "model:ir.message,text:msg_configuration_participant_unique"
msgid ""
"The combination of host ID, partner ID and user ID must be unique per "
"company."
msgstr ""
"Die Kombination aus Host-ID, Kunden-ID und Teilnehmer-ID muss je Unternehmen"
" eindeutig sein."

#, python-format
msgctxt "model:ir.message,text:msg_configuration_setting"
msgid ""
"The value \"%(name)s\" in the section [account_ebics] of trytond.conf is not"
" valid."
msgstr ""
"Der Wert „%(name)s“ im Abschnitt [account_ebics] der trytond.conf ist "
"ungültig."

#, python-format
msgctxt "model:ir.message,text:msg_configuration_url_https"
msgid ""
"The URL of EBICS connection \"%(configuration)s\" must start with "
"\"https://\"."
msgstr ""
"Die URL des EBICS-Zugangs „%(configuration)s“ muss mit „https://“ beginnen."

#, python-format
msgctxt "model:ir.message,text:msg_fetch_error"
msgid "%(configuration)s, %(format)s: %(error)s"
msgstr "%(configuration)s, %(format)s: %(error)s"

#, python-format
msgctxt "model:ir.message,text:msg_fetch_files"
msgid ""
"%(configuration)s, %(format)s: %(count)s file(s) received, of them "
"%(repeated)s repeated."
msgstr ""
"%(configuration)s, %(format)s: %(count)s Datei(en) empfangen, davon "
"%(repeated)s Wiederholung(en)."

#, python-format
msgctxt "model:ir.message,text:msg_fetch_no_data"
msgid "%(configuration)s, %(format)s: no new data."
msgstr "%(configuration)s, %(format)s: keine neuen Daten."

#, python-format
msgctxt "model:ir.message,text:msg_fetch_no_formats"
msgid "EBICS connection \"%(configuration)s\" has no formats to fetch."
msgstr "Der EBICS-Zugang „%(configuration)s“ hat keine abzurufenden Formate."

msgctxt "model:ir.message,text:msg_fetch_none"
msgid "There is no active EBICS connection for the current companies."
msgstr "Für die aktuellen Unternehmen gibt es keinen aktiven EBICS-Zugang."

#, python-format
msgctxt "model:ir.message,text:msg_fetch_not_active"
msgid ""
"EBICS connection \"%(configuration)s\" is not active; no statements are "
"fetched."
msgstr ""
"Der EBICS-Zugang „%(configuration)s“ ist nicht aktiv; es werden keine "
"Auszüge abgerufen."

msgctxt "model:ir.message,text:msg_fetch_period_dates"
msgid ""
"The start date must not be after the end date and the end date not after "
"today."
msgstr ""
"Das Von-Datum darf nicht nach dem Bis-Datum und das Bis-Datum nicht nach "
"heute liegen."

#, python-format
msgctxt "model:ir.message,text:msg_fetch_period_format"
msgid ""
"Format \"%(format)s\" is not a format of EBICS connection "
"\"%(configuration)s\"."
msgstr ""
"Das Format „%(format)s“ gehört nicht zum EBICS-Zugang „%(configuration)s“."

#, python-format
msgctxt "model:ir.message,text:msg_fetch_receipt_failed"
msgid ""
"%(configuration)s, %(format)s: %(count)s file(s) received (of them "
"%(repeated)s repeated) and stored, but the receipt failed (%(error)s). The "
"bank will deliver the data again."
msgstr ""
"%(configuration)s, %(format)s: %(count)s Datei(en) empfangen (davon "
"%(repeated)s Wiederholung(en)) und gespeichert, aber die Quittung ist "
"fehlgeschlagen (%(error)s). Die Bank liefert die Daten erneut."

#, python-format
msgctxt "model:ir.message,text:msg_fetch_summary"
msgid ""
"%(files)s file(s) received, of them %(repeated)s repeated, %(no_data)s "
"format(s) without new data, %(errors)s error(s)."
msgstr ""
"%(files)s Datei(en) empfangen, davon %(repeated)s Wiederholung(en), "
"%(no_data)s Format(e) ohne neue Daten, %(errors)s Fehler."

#, python-format
msgctxt "model:ir.message,text:msg_format_import_camt053"
msgid ""
"Format \"%(format)s\" can only be imported as statement for message "
"camt.053."
msgstr ""
"Das Format „%(format)s“ kann nur bei der Nachricht camt.053 als Kontoauszug "
"importiert werden."

#, python-format
msgctxt "model:ir.message,text:msg_format_processing_download"
msgid "The processing of format \"%(format)s\" is only allowed for downloads."
msgstr ""
"Eine Verarbeitung ist beim Format „%(format)s“ nur für Downloads zulässig."

#, python-format
msgctxt "model:ir.message,text:msg_format_processing_required"
msgid "The download format \"%(format)s\" requires a processing."
msgstr ""
"Für das Download-Format „%(format)s“ muss eine Verarbeitung angegeben "
"werden."

#, python-format
msgctxt "model:ir.message,text:msg_format_unique"
msgid ""
"A format with the BTF parameters \"%(btf)s\" already exists (format "
"\"%(format)s\")."
msgstr ""
"Ein Format mit der BTF-Angabe „%(btf)s“ existiert bereits (Format "
"„%(format)s“)."

#, python-format
msgctxt "model:ir.message,text:msg_hpb_not_released"
msgid ""
"EBICS connection \"%(configuration)s\" is not yet released by the bank "
"(091002 EBICS_INVALID_USER_OR_USER_STATE). Send the signed initialisation "
"letters to the bank and try again after the release."
msgstr ""
"Der EBICS-Zugang „%(configuration)s“ ist von der Bank noch nicht "
"freigeschaltet (091002 EBICS_INVALID_USER_OR_USER_STATE). Die "
"unterschriebenen Initialisierungsbriefe an die Bank senden und nach der "
"Freischaltung erneut versuchen."

#, python-format
msgctxt "model:ir.message,text:msg_keyring_missing"
msgid "EBICS connection \"%(configuration)s\" has no keys."
msgstr "Der EBICS-Zugang „%(configuration)s“ hat keine Schlüssel."

#, python-format
msgctxt "model:ir.message,text:msg_keyring_unreadable"
msgid ""
"The keys of EBICS connection \"%(configuration)s\" cannot be loaded (wrong "
"passphrase?)."
msgstr ""
"Die Schlüssel des EBICS-Zugangs „%(configuration)s“ können nicht geladen "
"werden (Passphrase falsch?)."

#, python-format
msgctxt "model:ir.message,text:msg_letter_not_sent"
msgid ""
"The initialisation letter %(order_type)s of EBICS connection "
"\"%(configuration)s\" can only be printed after the bank accepted "
"%(order_type)s."
msgstr ""
"Der Initialisierungsbrief %(order_type)s des EBICS-Zugangs "
"„%(configuration)s“ kann erst gedruckt werden, wenn die Bank %(order_type)s "
"angenommen hat."

#, python-format
msgctxt "model:ir.message,text:msg_log_copy"
msgid "Records of \"%(model)s\" cannot be copied."
msgstr "Datensätze von „%(model)s“ können nicht kopiert werden."

#, python-format
msgctxt "model:ir.message,text:msg_log_create"
msgid "Records of \"%(model)s\" are created only by the EBICS orders."
msgstr ""
"Datensätze von „%(model)s“ werden nur von den EBICS-Aufträgen angelegt."

#, python-format
msgctxt "model:ir.message,text:msg_log_delete"
msgid "Records of \"%(model)s\" cannot be deleted."
msgstr "Datensätze von „%(model)s“ können nicht gelöscht werden."

#, python-format
msgctxt "model:ir.message,text:msg_log_write"
msgid "Records of \"%(model)s\" cannot be changed."
msgstr "Datensätze von „%(model)s“ können nicht geändert werden."

#, python-format
msgctxt "model:ir.message,text:msg_log_write_fields"
msgid "The fields \"%(fields)s\" of \"%(model)s\" cannot be changed."
msgstr "Die Felder „%(fields)s“ von „%(model)s“ können nicht geändert werden."

#, python-format
msgctxt "model:ir.message,text:msg_order_ebics_error"
msgid ""
"EBICS error in %(order_type)s of connection \"%(configuration)s\": %(code)s "
"%(symbol)s: %(text)s"
msgstr ""
"EBICS-Fehler bei %(order_type)s des Zugangs „%(configuration)s“: %(code)s "
"%(symbol)s: %(text)s"

#, python-format
msgctxt "model:ir.message,text:msg_order_failed"
msgid ""
"The order %(order_type)s of EBICS connection \"%(configuration)s\" failed: "
"%(error)s"
msgstr ""
"Der Auftrag %(order_type)s des EBICS-Zugangs „%(configuration)s“ ist "
"fehlgeschlagen: %(error)s"

#, python-format
msgctxt "model:ir.message,text:msg_order_running"
msgid ""
"Another EBICS order of connection \"%(configuration)s\" is running. Please "
"try again later."
msgstr ""
"Für den EBICS-Zugang „%(configuration)s“ läuft bereits ein anderer EBICS-"
"Auftrag. Bitte später erneut versuchen."

#, python-format
msgctxt "model:ir.message,text:msg_order_user_state"
msgid ""
"The bank refused %(order_type)s of EBICS connection \"%(configuration)s\": "
"the participant is not in the state \"new\" at the bank (already initialised"
" or locked)."
msgstr ""
"Die Bank hat %(order_type)s des EBICS-Zugangs „%(configuration)s“ abgelehnt:"
" Der Teilnehmer ist bei der Bank nicht im Zustand „neu“ (bereits "
"initialisiert oder gesperrt)."

#, python-format
msgctxt "model:ir.message,text:msg_participant_suspended"
msgid ""
"The bank refused %(order_type)s of EBICS connection \"%(configuration)s\": "
"the participant is locked at the bank (091004 EBICS_INVALID_USER_STATE)."
msgstr ""
"Die Bank hat %(order_type)s des EBICS-Zugangs „%(configuration)s“ abgelehnt:"
" Der Teilnehmer ist bei der Bank gesperrt (091004 EBICS_INVALID_USER_STATE)."

msgctxt "model:ir.message,text:msg_passphrase_missing"
msgid ""
"The passphrase of the EBICS keys is missing in the section [account_ebics] "
"of trytond.conf (or the environment variable "
"TRYTOND_ACCOUNT_EBICS__PASSPHRASE)."
msgstr ""
"Die Passphrase der EBICS-Schlüssel fehlt im Abschnitt [account_ebics] der "
"trytond.conf (oder in der Umgebungsvariablen "
"TRYTOND_ACCOUNT_EBICS__PASSPHRASE)."

#, python-format
msgctxt "model:ir.message,text:msg_reactivate_no_bank_keys"
msgid ""
"EBICS connection \"%(configuration)s\" cannot be reactivated without "
"confirmed bank keys."
msgstr ""
"Der EBICS-Zugang „%(configuration)s“ kann ohne bestätigte Bankschlüssel "
"nicht reaktiviert werden."

#, python-format
msgctxt "model:ir.message,text:msg_reset_not_confirmed"
msgid ""
"Please confirm the deletion of the keys of EBICS connection "
"\"%(configuration)s\"."
msgstr ""
"Bitte das Löschen der Schlüssel des EBICS-Zugangs „%(configuration)s“ "
"bestätigen."

#, python-format
msgctxt "model:ir.message,text:msg_run_aborted"
msgid "Run aborted by an unexpected error: %(error)s"
msgstr "Lauf durch einen unerwarteten Fehler abgebrochen: %(error)s"

#, python-format
msgctxt "model:ir.message,text:msg_run_company"
msgid "Company %(company)s: %(count)s active EBICS connection(s)"
msgstr "Unternehmen %(company)s: %(count)s aktive(r) EBICS-Zugang/-Zugänge"

#, python-format
msgctxt "model:ir.message,text:msg_run_connection"
msgid "EBICS connection \"%(configuration)s\": formats %(formats)s"
msgstr "EBICS-Zugang „%(configuration)s“: Formate %(formats)s"

#, python-format
msgctxt "model:ir.message,text:msg_run_connections"
msgid "%(count)s EBICS connection(s) to fetch: %(configurations)s"
msgstr "%(count)s EBICS-Zugang/-Zugänge abzurufen: %(configurations)s"

#, python-format
msgctxt "model:ir.message,text:msg_run_cron"
msgid "cron %(cron)s"
msgstr "Cron %(cron)s"

#, python-format
msgctxt "model:ir.message,text:msg_run_finished"
msgid "Run finished: %(summary)s"
msgstr "Lauf beendet: %(summary)s"

#, python-format
msgctxt "model:ir.message,text:msg_run_formats_skipped"
msgid "%(configuration)s: remaining formats skipped: %(formats)s"
msgstr "%(configuration)s: übrige Formate übersprungen: %(formats)s"

#, python-format
msgctxt "model:ir.message,text:msg_run_last_fetch"
msgid "%(configuration)s: last fetch set"
msgstr "%(configuration)s: letzter Abruf gesetzt"

msgctxt "model:ir.message,text:msg_run_no_company"
msgid "No company in the context of the cron: add the companies in the cron."
msgstr ""
"Kein Unternehmen im Kontext des Crons: die Unternehmen im Cron-Eintrag "
"eintragen."

#, python-format
msgctxt "model:ir.message,text:msg_run_receipt"
msgid ""
"%(configuration)s, %(format)s: positive receipt sent, answer of the bank "
"%(code)s"
msgstr ""
"%(configuration)s, %(format)s: positive Quittung gesendet, Antwort der Bank "
"%(code)s"

#, python-format
msgctxt "model:ir.message,text:msg_run_request"
msgid "%(configuration)s, %(format)s: BTD request %(btf)s%(period)s sent"
msgstr "%(configuration)s, %(format)s: BTD-Anfrage %(btf)s%(period)s gesendet"

#, python-format
msgctxt "model:ir.message,text:msg_run_skipped"
msgid "EBICS connection \"%(configuration)s\" skipped: state %(state)s"
msgstr "EBICS-Zugang „%(configuration)s“ übersprungen: Status %(state)s"

#, python-format
msgctxt "model:ir.message,text:msg_run_started"
msgid "Run started: %(trigger)s"
msgstr "Lauf gestartet: %(trigger)s"

#, python-format
msgctxt "model:ir.message,text:msg_run_stored"
msgid ""
"%(configuration)s, %(format)s: %(count)s file(s) received, of them "
"%(repeated)s repeated (%(segments)s segment(s)), stored in EBICS log %(log)s"
msgstr ""
"%(configuration)s, %(format)s: %(count)s Datei(en) empfangen, davon "
"%(repeated)s Wiederholung(en) (%(segments)s Segment(e)), gespeichert im "
"EBICS-Protokoll %(log)s"

#, python-format
msgctxt "model:ir.message,text:msg_run_user"
msgid "user %(user)s"
msgstr "Benutzer %(user)s"

#, python-format
msgctxt "model:ir.message,text:msg_run_with_log"
msgid "%(text)s (EBICS log %(log)s)"
msgstr "%(text)s (EBICS-Protokoll %(log)s)"

#, python-format
msgctxt "model:ir.message,text:msg_transport_error"
msgid ""
"The connection to the bank failed for EBICS connection "
"\"%(configuration)s\": %(error)s"
msgstr ""
"Die Verbindung zur Bank ist für den EBICS-Zugang „%(configuration)s“ "
"fehlgeschlagen: %(error)s"

msgctxt "model:ir.model.button,string:configuration_confirm_bank_keys_button"
msgid "Confirm Bank Keys"
msgstr "Bankschlüssel bestätigen"

msgctxt ""
"model:ir.model.button,string:configuration_download_statements_button"
msgid "Fetch Statements"
msgstr "Auszüge abrufen"

msgctxt "model:ir.model.button,string:configuration_fetch_bank_keys_button"
msgid "Fetch Bank Keys"
msgstr "Bankschlüssel abrufen"

msgctxt "model:ir.model.button,string:configuration_generate_keys_button"
msgid "Generate Keys"
msgstr "Schlüssel erzeugen"

msgctxt "model:ir.model.button,string:configuration_print_hia_letter_button"
msgid "HIA Letter"
msgstr "HIA-Brief"

msgctxt "model:ir.model.button,string:configuration_print_ini_letter_button"
msgid "INI Letter"
msgstr "INI-Brief"

