<tryton>
    <data>
        <!-- Financial > Configuration > EBICS: settings (E04 ff.: EBICS
             accesses, released accounts). Only for EBICS administrators;
             the parent menu additionally requires group_account_admin. -->
        <menuitem
            name="Electronic Banking (EBICS)"
            parent="account.menu_account_configuration"
            sequence="50"
            id="menu_ebics_configuration"
            icon="tryton-settings"/>
        <record model="ir.ui.menu-res.group"
            id="menu_ebics_configuration_group_ebics_admin">
            <field name="menu" ref="menu_ebics_configuration"/>
            <field name="group" ref="group_ebics_admin"/>
        </record>

        <!-- Financial > EBICS: operation (E05, E08, E09: fetch statements,
             fetch missed statements, log). For both EBICS groups; the parent
             menu additionally requires group_account or group_account_admin.
             -->
        <menuitem
            name="Electronic Banking (EBICS)"
            parent="account.menu_account"
            sequence="40"
            id="menu_ebics"/>
        <record model="ir.ui.menu-res.group" id="menu_ebics_group_ebics">
            <field name="menu" ref="menu_ebics"/>
            <field name="group" ref="group_ebics"/>
        </record>
        <record model="ir.ui.menu-res.group" id="menu_ebics_group_ebics_admin">
            <field name="menu" ref="menu_ebics"/>
            <field name="group" ref="group_ebics_admin"/>
        </record>
    </data>
</tryton>
