<!-- This file is part of the account_ebics module for Tryton.
The COPYRIGHT file at the top level of this repository contains the full
copyright notices and license terms. -->
<tryton>
    <data>
        <record model="ir.ui.view" id="format_view_form">
            <field name="model">account.ebics.format</field>
            <field name="type">form</field>
            <field name="name">connection/format_form</field>
        </record>
        <record model="ir.ui.view" id="format_view_list">
            <field name="model">account.ebics.format</field>
            <field name="type">tree</field>
            <field name="name">connection/format_list</field>
        </record>

        <record model="ir.action.act_window" id="act_format_form">
            <field name="name">Formats</field>
            <field name="res_model">account.ebics.format</field>
        </record>
        <record model="ir.action.act_window.view" id="act_format_form_view1">
            <field name="sequence" eval="10"/>
            <field name="view" ref="format_view_list"/>
            <field name="act_window" ref="act_format_form"/>
        </record>
        <record model="ir.action.act_window.view" id="act_format_form_view2">
            <field name="sequence" eval="20"/>
            <field name="view" ref="format_view_form"/>
            <field name="act_window" ref="act_format_form"/>
        </record>
        <menuitem
            parent="menu_ebics_configuration"
            action="act_format_form"
            sequence="30"
            id="menu_format_form"/>

        <record model="ir.model.access" id="access_format">
            <field name="model">account.ebics.format</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_format_ebics">
            <field name="model">account.ebics.format</field>
            <field name="group" ref="group_ebics"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_format_ebics_admin">
            <field name="model">account.ebics.format</field>
            <field name="group" ref="group_ebics_admin"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="True"/>
        </record>
    </data>

    <!-- Standard formats of the DK mapping table (version 23.10.2026),
         specification ch. 5.5; noupdate keeps changes of the administrator -->
    <data noupdate="1">
        <record model="account.ebics.format" id="format_camt053_de">
            <field name="name">Daily Statement (camt.053)</field>
            <field name="direction">download</field>
            <field name="service_name">EOP</field>
            <field name="scope">DE</field>
            <field name="msg_name">camt.053</field>
            <field name="container">ZIP</field>
            <field name="processing">import_statement</field>
        </record>
        <record model="account.ebics.format" id="format_camt052_de">
            <field name="name">Intraday Transactions (camt.052)</field>
            <field name="direction">download</field>
            <field name="service_name">STM</field>
            <field name="scope">DE</field>
            <field name="msg_name">camt.052</field>
            <field name="container">ZIP</field>
            <field name="processing">store</field>
        </record>
        <record model="account.ebics.format" id="format_camt054_de">
            <field name="name">Batch Booking Details (camt.054)</field>
            <field name="direction">download</field>
            <field name="service_name">STM</field>
            <field name="scope">DE</field>
            <field name="msg_name">camt.054</field>
            <field name="container">ZIP</field>
            <field name="processing">store</field>
        </record>
    </data>
</tryton>
