<tryton>
    <data>
        <record model="ir.ui.view" id="configuration_view_form">
            <field name="model">account.ebics.configuration</field>
            <field name="type">form</field>
            <field name="name">connection/configuration_form</field>
        </record>
        <record model="ir.ui.view" id="configuration_view_list">
            <field name="model">account.ebics.configuration</field>
            <field name="type">tree</field>
            <field name="name">connection/configuration_list</field>
        </record>

        <record model="ir.action.act_window" id="act_configuration_form">
            <field name="name">EBICS Connections</field>
            <field name="res_model">account.ebics.configuration</field>
        </record>
        <record model="ir.action.act_window.view" id="act_configuration_form_view1">
            <field name="sequence" eval="10"/>
            <field name="view" ref="configuration_view_list"/>
            <field name="act_window" ref="act_configuration_form"/>
        </record>
        <record model="ir.action.act_window.view" id="act_configuration_form_view2">
            <field name="sequence" eval="20"/>
            <field name="view" ref="configuration_view_form"/>
            <field name="act_window" ref="act_configuration_form"/>
        </record>
        <menuitem
            parent="menu_ebics_configuration"
            action="act_configuration_form"
            sequence="10"
            id="menu_configuration_form"/>

        <record model="ir.model.access" id="access_configuration">
            <field name="model">account.ebics.configuration</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_configuration_ebics">
            <field name="model">account.ebics.configuration</field>
            <field name="group" ref="group_ebics"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_configuration_ebics_admin">
            <field name="model">account.ebics.configuration</field>
            <field name="group" ref="group_ebics_admin"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="True"/>
        </record>

        <record model="ir.model.access" id="access_configuration_format">
            <field name="model">account.ebics.configuration-account.ebics.format</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_configuration_format_ebics">
            <field name="model">account.ebics.configuration-account.ebics.format</field>
            <field name="group" ref="group_ebics"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_configuration_format_ebics_admin">
            <field name="model">account.ebics.configuration-account.ebics.format</field>
            <field name="group" ref="group_ebics_admin"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="True"/>
        </record>

        <!-- Key fields: no read or write access for anybody, only server
             code (specification ch. 9) -->
        <record model="ir.model.field.access" id="access_configuration_keyring_data">
            <field name="model">account.ebics.configuration</field>
            <field name="field">keyring_data</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
        </record>
        <record model="ir.model.field.access" id="access_configuration_keyring_data_id">
            <field name="model">account.ebics.configuration</field>
            <field name="field">keyring_data_id</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
        </record>
        <record model="ir.model.field.access" id="access_configuration_bank_keys_data">
            <field name="model">account.ebics.configuration</field>
            <field name="field">bank_keys_data</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
        </record>
        <record model="ir.model.field.access" id="access_configuration_bank_keys_data_id">
            <field name="model">account.ebics.configuration</field>
            <field name="field">bank_keys_data_id</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
        </record>

        <!-- Buttons only for the EBICS administrator (working paper E06
             ch. 4.1) -->
        <record model="ir.model.button" id="configuration_generate_keys_button">
            <field name="model">account.ebics.configuration</field>
            <field name="name">generate_keys</field>
            <field name="string">Generate Keys</field>
        </record>
        <record model="ir.model.button-res.group" id="configuration_generate_keys_button_group_ebics_admin">
            <field name="button" ref="configuration_generate_keys_button"/>
            <field name="group" ref="group_ebics_admin"/>
        </record>
        <record model="ir.model.button" id="configuration_send_ini_button">
            <field name="model">account.ebics.configuration</field>
            <field name="name">send_ini</field>
            <field name="string">Send INI</field>
        </record>
        <record model="ir.model.button-res.group" id="configuration_send_ini_button_group_ebics_admin">
            <field name="button" ref="configuration_send_ini_button"/>
            <field name="group" ref="group_ebics_admin"/>
        </record>
        <record model="ir.model.button" id="configuration_send_hia_button">
            <field name="model">account.ebics.configuration</field>
            <field name="name">send_hia</field>
            <field name="string">Send HIA</field>
        </record>
        <record model="ir.model.button-res.group" id="configuration_send_hia_button_group_ebics_admin">
            <field name="button" ref="configuration_send_hia_button"/>
            <field name="group" ref="group_ebics_admin"/>
        </record>
        <record model="ir.model.button" id="configuration_reset_draft_button">
            <field name="model">account.ebics.configuration</field>
            <field name="name">reset_draft</field>
            <field name="string">Reset to Draft</field>
        </record>
        <record model="ir.model.button-res.group" id="configuration_reset_draft_button_group_ebics_admin">
            <field name="button" ref="configuration_reset_draft_button"/>
            <field name="group" ref="group_ebics_admin"/>
        </record>
        <record model="ir.model.button" id="configuration_print_ini_letter_button">
            <field name="model">account.ebics.configuration</field>
            <field name="name">print_ini_letter</field>
            <field name="string">INI Letter</field>
        </record>
        <record model="ir.model.button-res.group" id="configuration_print_ini_letter_button_group_ebics_admin">
            <field name="button" ref="configuration_print_ini_letter_button"/>
            <field name="group" ref="group_ebics_admin"/>
        </record>
        <record model="ir.model.button" id="configuration_print_hia_letter_button">
            <field name="model">account.ebics.configuration</field>
            <field name="name">print_hia_letter</field>
            <field name="string">HIA Letter</field>
        </record>
        <record model="ir.model.button-res.group" id="configuration_print_hia_letter_button_group_ebics_admin">
            <field name="button" ref="configuration_print_hia_letter_button"/>
            <field name="group" ref="group_ebics_admin"/>
        </record>

        <!-- Dialog "Reset to Draft" (working paper E06 ch. 4.6) -->
        <record model="ir.ui.view" id="configuration_reset_draft_start_view_form">
            <field name="model">account.ebics.configuration.reset_draft.start</field>
            <field name="type">form</field>
            <field name="name">connection/configuration_reset_draft_start_form</field>
        </record>
        <record model="ir.action.wizard" id="wizard_configuration_reset_draft">
            <field name="name">Reset to Draft</field>
            <field name="wiz_name">account.ebics.configuration.reset_draft</field>
            <field name="model">account.ebics.configuration</field>
        </record>
        <record model="ir.action-res.group" id="wizard_configuration_reset_draft_group_ebics_admin">
            <field name="action" ref="wizard_configuration_reset_draft"/>
            <field name="group" ref="group_ebics_admin"/>
        </record>

        <!-- Buttons of the bank keys (working paper E07 ch. 4.1) -->
        <record model="ir.model.button" id="configuration_fetch_bank_keys_button">
            <field name="model">account.ebics.configuration</field>
            <field name="name">fetch_bank_keys</field>
            <field name="string">Fetch Bank Keys</field>
        </record>
        <record model="ir.model.button-res.group" id="configuration_fetch_bank_keys_button_group_ebics_admin">
            <field name="button" ref="configuration_fetch_bank_keys_button"/>
            <field name="group" ref="group_ebics_admin"/>
        </record>
        <record model="ir.model.button" id="configuration_confirm_bank_keys_button">
            <field name="model">account.ebics.configuration</field>
            <field name="name">confirm_bank_keys</field>
            <field name="string">Confirm Bank Keys</field>
        </record>
        <record model="ir.model.button-res.group" id="configuration_confirm_bank_keys_button_group_ebics_admin">
            <field name="button" ref="configuration_confirm_bank_keys_button"/>
            <field name="group" ref="group_ebics_admin"/>
        </record>
        <record model="ir.model.button" id="configuration_suspend_button">
            <field name="model">account.ebics.configuration</field>
            <field name="name">suspend</field>
            <field name="string">Suspend</field>
        </record>
        <record model="ir.model.button-res.group" id="configuration_suspend_button_group_ebics_admin">
            <field name="button" ref="configuration_suspend_button"/>
            <field name="group" ref="group_ebics_admin"/>
        </record>
        <record model="ir.model.button" id="configuration_reactivate_button">
            <field name="model">account.ebics.configuration</field>
            <field name="name">reactivate</field>
            <field name="string">Reactivate</field>
        </record>
        <record model="ir.model.button-res.group" id="configuration_reactivate_button_group_ebics_admin">
            <field name="button" ref="configuration_reactivate_button"/>
            <field name="group" ref="group_ebics_admin"/>
        </record>

        <!-- Dialog "Confirm Bank Keys" (working paper E07 ch. 4.3) -->
        <record model="ir.ui.view" id="configuration_confirm_bank_keys_start_view_form">
            <field name="model">account.ebics.configuration.confirm_bank_keys.start</field>
            <field name="type">form</field>
            <field name="name">connection/configuration_confirm_bank_keys_start_form</field>
        </record>
        <record model="ir.action.wizard" id="wizard_configuration_confirm_bank_keys">
            <field name="name">Confirm Bank Keys</field>
            <field name="wiz_name">account.ebics.configuration.confirm_bank_keys</field>
            <field name="model">account.ebics.configuration</field>
        </record>
        <record model="ir.action-res.group" id="wizard_configuration_confirm_bank_keys_group_ebics_admin">
            <field name="action" ref="wizard_configuration_confirm_bank_keys"/>
            <field name="group" ref="group_ebics_admin"/>
        </record>

        <!-- Button "Fetch Statements" for both EBICS groups (working paper
             E08 ch. 4.1) -->
        <record model="ir.model.button" id="configuration_download_statements_button">
            <field name="model">account.ebics.configuration</field>
            <field name="name">download_statements</field>
            <field name="string">Fetch Statements</field>
        </record>
        <record model="ir.model.button-res.group" id="configuration_download_statements_button_group_ebics">
            <field name="button" ref="configuration_download_statements_button"/>
            <field name="group" ref="group_ebics"/>
        </record>
        <record model="ir.model.button-res.group" id="configuration_download_statements_button_group_ebics_admin">
            <field name="button" ref="configuration_download_statements_button"/>
            <field name="group" ref="group_ebics_admin"/>
        </record>

        <record model="ir.rule.group" id="rule_group_configuration_companies">
            <field name="name">User in companies</field>
            <field name="model">account.ebics.configuration</field>
            <field name="global_p" eval="True"/>
        </record>
        <record model="ir.rule" id="rule_configuration_companies">
            <field name="domain"
                eval="[('company', 'in', Eval('companies', []))]"
                pyson="1"/>
            <field name="rule_group" ref="rule_group_configuration_companies"/>
        </record>
    </data>
</tryton>
